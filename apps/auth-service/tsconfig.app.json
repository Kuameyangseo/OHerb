{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/auth-service",
    "module": "nodenext",
    "types": [
      "node",
      "express"
    ],
    "paths": {
      "@middleware/*": ["packages/middleware/*"]
    },
    "rootDir": "../../",
    "tsBuildInfoFile": "out-tsc/auth-service/tsconfig.app.tsbuildinfo",
  },
  //"path": ["packages/*"]
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "src/swagger-output.json",
    "../../packages/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
